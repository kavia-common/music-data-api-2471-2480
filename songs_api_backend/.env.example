# Database configuration
# The orchestrator will copy these into the running environment. Do NOT commit real secrets.

# sqlite | sqlserver | postgres
DATABASE_PROVIDER=sqlite

# For sqlite only (optional). Can be a relative or absolute path. Default: Data/music.db inside application folder.
#SQLITE_PATH=Data/music.db

# For sqlserver/postgres provide a full connection string:
#DATABASE_CONNECTION_STRING=Server=localhost;Port=5432;Database=musicdb;User Id=postgres;Password=secret;
